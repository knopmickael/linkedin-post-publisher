# Optional: actual values must be set in the server or CLI environment.
PORT=4317
APP_ORIGIN=http://127.0.0.1:4317
# APP_DATA_DIR=C:\Users\your-user\AppData\Local\LinkedInPostPublisher
# For LinkedIn portals requiring HTTPS, use a trusted local certificate:
# APP_ORIGIN=https://localhost:4317
# TLS_CERT_PATH=C:\certificates\localhost.pem
# TLS_KEY_PATH=C:\certificates\localhost-key.pem
# Windows DPAPI is the default. For non-Windows development only:
# APP_SECRET_KEY=<32 random bytes encoded as base64>
